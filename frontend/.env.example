# LivingDocs Frontend Configuration

# Chế độ dữ liệu: 'mock' (phát triển offline) hoặc 'real' (kết nối trực tiếp backend)
VITE_API_MODE=mock

# Đường dẫn cơ sở cho Document Service
VITE_API_BASE_URL=/api/v1/documents

# Đường dẫn cơ sở cho Governance Service (Templates & Collections)
VITE_GOVERNANCE_API_URL=/api/v1/governance
