# Copy file nay thanh .env roi doi gia tri. File .env KHONG duoc commit.
# Dùng hai secrets khác nhau. DB_USER phải là principal ứng dụng có quyền tối thiểu.
# Thay toàn bộ giá trị CHANGE_ME trước khi chạy; không dùng file mẫu làm credentials.
MSSQL_SA_PASSWORD=CHANGE_ME_8a!SQL_admin_password

# Khoa ky JWT (HS256), dai it nhat 32 ky tu. Cac service trong compose dung chung gia tri nay.
JWT_SECRET=CHANGE_ME_generate_at_least_32_random_bytes
DB_USER=livingdocs_app
DB_PASSWORD=CHANGE_ME_8a!application_db_password
TOKEN_ENCRYPTION_KEY=CHANGE_ME_base64_of_32_random_bytes
GITHUB_WEBHOOK_SECRET=CHANGE_ME_generate_random_webhook_secret

# GitHub OAuth Login (FR-AUTH-02)
GITHUB_CLIENT_ID=CHANGE_ME_github_oauth_client_id
GITHUB_CLIENT_SECRET=CHANGE_ME_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://localhost:5173/auth/callback
GITHUB_SCOPE=read:user,user:email,repo
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PEM=
INTERNAL_SERVICE_TOKEN=CHANGE_ME_random_32_byte_internal_service_token
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
COOKIE_SECURE=true
API_DOMAIN=localhost

