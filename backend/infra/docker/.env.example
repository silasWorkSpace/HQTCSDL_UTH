# Copy file nay thanh .env roi doi gia tri. File .env KHONG duoc commit.
# Mat khau SQL Server can du manh: toi thieu 8 ky tu, co chu hoa, chu thuong, so va ky hieu.
# Khong dung dau nhay, dau $ hoac # trong mat khau.
MSSQL_SA_PASSWORD=Living_Docs_2026!

# Khoa ky JWT (HS256), dai it nhat 32 ky tu. Cac service trong compose dung chung gia tri nay.
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me

# GitHub OAuth Login (FR-AUTH-02)
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_REDIRECT_URI=http://localhost:5173/auth/callback
GITHUB_SCOPE=read:user,user:email,repo

